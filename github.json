          }
        }
      }
    },
    "repo-template": {
      "visibility": "public",
      "settings": {
        "description": "Mal for nye repo i hofstadnet",
        "is_template": true
      },
      "rulesets": {
        "Main protection": {
          "extends": "main",
          "rules": {
            "pull_request": { "dismiss_stale_reviews_on_push": false },
            "required_status_checks": { "strict_required_status_checks_policy": true }
          }
        }
      }
    },
    ".github": {
      "visibility": "public",
      "settings": {
        "description": "Standardfiler for hofstadnet"
      }
    },
    "operations": {
      "visibility": "public",
      "settings": {
        "description": "Drift av hofstadnet: GitHub-innstillinger som kode, kontroll av oppsettet, sertifikater og utløpsdatoer"
