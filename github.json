        "_review": "Til gjennomgang: har tilgang til alle repoene og bred skrivetilgang (også repository_creation og repository_hooks).",
        "repository_selection": "all",
        "permissions": { "actions": "write", "administration": "read", "checks": "write", "contents": "write", "discussions": "write", "issues": "write", "members": "read", "merge_queues": "read", "metadata": "read", "pull_requests": "write", "repository_creation": "write", "repository_hooks": "write", "statuses": "read", "vulnerability_alerts": "read", "workflows": "write" }
      },
      "chatgpt-codex-connector": {
        "_review": "Til gjennomgang: har tilgang til alle repoene.",
        "repository_selection": "all",
        "permissions": { "actions": "write", "checks": "read", "contents": "write", "issues": "write", "metadata": "read", "pull_requests": "write", "statuses": "read", "workflows": "write" }
      },
      "cursor": {
        "repository_selection": "selected",
        "permissions": { "actions": "write", "administration": "read", "checks": "write", "contents": "write", "deployments": "read", "discussions": "write", "issues": "write", "members": "read", "merge_queues": "write", "metadata": "read", "organization_custom_org_roles": "read", "organization_custom_properties": "read", "organization_custom_roles": "read", "packages": "read", "pages": "read", "pull_requests": "write", "statuses": "read", "workflows": "write" }
      },
      "cloudflare-workers-and-pages": {
