    "environment": {
      "branches": ["main"],
      "reviewers": [],
      "can_admins_bypass": true,
      "wait_timer": 0,
      "variables": {},
      "secrets": []
    }
  },
  "rulesets": {
    "main": {
      "target": "branch",
      "enforcement": "active",
      "conditions": { "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] } },
      "bypass_actors": [{ "role": "admin", "mode": "pull_request" }],
      "rules": {
        "deletion": {},
        "non_fast_forward": {},
        "pull_request": {
          "required_approving_review_count": 0,
          "dismiss_stale_reviews_on_push": true,
          "require_code_owner_review": false,
          "require_last_push_approval": false,
          "required_review_thread_resolution": true,
          "allowed_merge_methods": ["merge", "squash", "rebase"]
        },
        "required_status_checks": {
          "strict_required_status_checks_policy": false,
          "do_not_enforce_on_create": false,
          "required_status_checks": ["dependency-review", "workflow-security"]
        },
        "code_scanning": {
          "code_scanning_tools": [{ "tool": "CodeQL", "security_alerts_threshold": "high_or_higher", "alerts_threshold": "errors" }]
        }
      }
    }
  },
  "repos": {
    "hofstadnet-web": {
      "visibility": "public",
      "settings": {
        "description": "Kildekoden til hofstad.net: statisk side i Astro på Cloudflare Workers",
        "homepage": "https://hofstad.net"
      },
      "rulesets": {
        "Main protection": {
          "extends": "main",
          "rules": {
            "pull_request": { "dismiss_stale_reviews_on_push": false },
            "required_status_checks": {
              "strict_required_status_checks_policy": true,
              "required_status_checks": ["build", "dependency-review", "workflow-security"]
            }
          }
        }
      },
      "variables": { "TOFU_ENABLED": "true" },
      "secrets": ["ALERT_EMAIL", "CLOUDFLARE_API_TOKEN_READ", "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY", "TOFU_STATE_PASSPHRASE"],
      "environments": {
        "cloudflare": {
          "reviewers": [{ "team": "maintainers" }],
          "prevent_self_review": false,
          "secrets": ["CLOUDFLARE_API_TOKEN"]
        }
      },
      "manual": [
        "Appen cloudflare-workers-and-pages (Workers Builds) må ha tilgang til hofstadnet-web i installasjonen."
      ]
    },
    "status": {
      "visibility": "public",
      "settings": {
        "description": "Oppetid og statusside for hofstad.net (Upptime)"
      },
      "rulesets": {
        "Main protection": {
          "_about": "Upptime skriver direkte til main med tokenet fra appen hofstadnet-status, som derfor er unntatt. Alle andre endringer går via pull request.",
          "extends": "main",
          "bypass_actors": [{ "role": "admin", "mode": "pull_request" }, { "app": "hofstadnet-status", "mode": "always" }]
        }
      },
      "environments": {
        "github-pages": { "branches": ["gh-pages"] },
        "status": {
          "variables": { "STATUS_APP_ID": "5899832" },
          "secrets": ["STATUS_APP_PRIVATE_KEY"]
        }
      },
      "pages": {
        "build_type": "legacy",
        "source": { "branch": "gh-pages", "path": "/" },
        "cname": "status.hofstad.net",
        "https_enforced": true
      },
      "manual": [
        "Appen hofstadnet-status (HofstadNET Status) må være installert bare på status, med Contents og Issues: write.",
        "Egen 404-side for Pages (custom_404) kommer fra innholdet i gh-pages og settes ikke med API-et."
      ]
    },
    "guidelines": {
      "visibility": "public",
      "settings": {
        "description": "Felles retningslinjer for repoer og kodeagenter: navngivning, dokumentasjon, sikkerhet, infrastruktur og UX"
      },
      "rulesets": {
        "Main protection": {
          "extends": "main",
